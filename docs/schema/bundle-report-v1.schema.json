{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shellghostt/envdoctor/schema/bundle-report-v1.schema.json",
  "title": "EnvDoctor shared reference diagnosis v1",
  "allOf": [
    {
      "$ref": "https://github.com/shellghostt/envdoctor/schema/diagnose-v1.schema.json"
    },
    {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "$ref": "https://github.com/shellghostt/envdoctor/schema/bundle-common-v1.schema.json#/$defs/source"
        },
        "generatedAt": {
          "$ref": "https://github.com/shellghostt/envdoctor/schema/bundle-common-v1.schema.json#/$defs/utc"
        },
        "tool": {
          "$ref": "https://github.com/shellghostt/envdoctor/schema/bundle-common-v1.schema.json#/$defs/tool"
        },
        "findings": {
          "type": "array",
          "items": {},
          "maxItems": 4096
        },
        "collectors": {
          "type": "array",
          "items": {},
          "maxItems": 32
        }
      }
    }
  ]
}
