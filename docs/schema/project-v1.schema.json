{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shellghostt/envdoctor/schema/project-v1.schema.json",
  "title": "EnvDoctor explicit project requirements v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "tool",
              "library"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "path": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "maxItems": 32
    },
    "gitAutocrlf": {
      "type": "string",
      "enum": [
        "true",
        "false",
        "input"
      ]
    }
  }
}
