{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shellghostt/envdoctor/schema/bundle-common-v1.schema.json",
  "title": "EnvDoctor bundle v1 common types",
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(?:[0-9]{1,9}(?:\\.[0-9]{1,9}){0,3})?$",
      "maxLength": 39
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "envdoctor"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:dev|[0-9]{1,9}(?:\\.[0-9]{1,9}){0,3})$",
          "maxLength": 39
        }
      }
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40
    },
    "collector": {
      "type": "string",
      "enum": [
        "platform",
        "shell",
        "path",
        "runtimes",
        "network",
        "docker",
        "git",
        "deps",
        "proxy"
      ]
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "reason"
      ],
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "platform",
            "platform.version",
            "shell.name",
            "shell.path",
            "path.locations",
            "runtimes.paths",
            "runtimes.version",
            "runtimes.name",
            "runtimes.manager",
            "runtimes.resolution",
            "runtimes.environment",
            "network.ownership",
            "docker.context",
            "docker.endpoint",
            "docker.version",
            "docker.api",
            "git.identity",
            "git.origins",
            "git.version",
            "git.autocrlf",
            "dependencies.locations",
            "dependencies.requirement",
            "dependencies.packageManager",
            "dependencies.lockfile",
            "dependencies.gitAutocrlf",
            "pythonEnvironment.locations",
            "proxy.endpoint",
            "proxy.url",
            "collector.errors",
            "tool.version"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "identifying_values",
            "raw_error",
            "unsupported_value",
            "unavailable_evidence"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "captureTool",
        "capturedAt",
        "redactionPolicy",
        "captureExitCode",
        "omissions"
      ],
      "properties": {
        "kind": {
          "const": "bundle"
        },
        "captureTool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "const": "envdoctor"
            },
            "version": {
              "type": "string",
              "pattern": "^(?:dev|[0-9]{1,9}(?:\\.[0-9]{1,9}){0,3})$",
              "maxLength": 39
            }
          }
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        },
        "redactionPolicy": {
          "const": "allowlist-v1"
        },
        "captureExitCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "reason"
            ],
            "properties": {
              "field": {
                "type": "string",
                "enum": [
                  "platform",
                  "platform.version",
                  "shell.name",
                  "shell.path",
                  "path.locations",
                  "runtimes.paths",
                  "runtimes.version",
                  "runtimes.name",
                  "runtimes.manager",
                  "runtimes.resolution",
                  "runtimes.environment",
                  "network.ownership",
                  "docker.context",
                  "docker.endpoint",
                  "docker.version",
                  "docker.api",
                  "git.identity",
                  "git.origins",
                  "git.version",
                  "git.autocrlf",
                  "dependencies.locations",
                  "dependencies.requirement",
                  "dependencies.packageManager",
                  "dependencies.lockfile",
                  "dependencies.gitAutocrlf",
                  "pythonEnvironment.locations",
                  "proxy.endpoint",
                  "proxy.url",
                  "collector.errors",
                  "tool.version"
                ]
              },
              "reason": {
                "type": "string",
                "enum": [
                  "identifying_values",
                  "raw_error",
                  "unsupported_value",
                  "unavailable_evidence"
                ]
              }
            }
          },
          "maxItems": 256,
          "uniqueItems": true
        }
      }
    },
    "pathToken": {
      "type": "string",
      "pattern": "^path-(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-6])$"
    },
    "environmentToken": {
      "type": "string",
      "pattern": "^env-(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-6])$"
    },
    "hostToken": {
      "type": "string",
      "pattern": "^host-(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-6])\\.invalid$"
    },
    "api": {
      "type": "string",
      "pattern": "^(?:1\\.[0-9]{1,6})?$",
      "maxLength": 8
    },
    "autocrlf": {
      "type": "string",
      "enum": [
        "",
        "true",
        "false",
        "input"
      ]
    }
  }
}
